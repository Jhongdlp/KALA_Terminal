<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for SSH connections and the in-app updater. Flutter only
         injects this automatically in debug builds; release APKs need it here. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the process (and its SSH shells) alive while the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Optional wakelock so long-running tasks keep executing with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required on Android 13+ to show the persistent foreground notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app updater: download the latest APK from GitHub Releases and hand it
         to the system package installer (see lib/services/update_service.dart).
         The user still confirms the install in the system dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice dictation in the prompt composer (speech_to_text plugin). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Shared-storage access (targetSdk 28 legacy permissions grant the whole
         /storage/emulated/0): the "adjuntar" file picker reads files from it and
         the SFTP downloader saves downloads into Download/KALA. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="KALA"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Foreground service that keeps terminal sessions alive in the background. -->
        <service
            android:name=".TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantiene las sesiones de terminal del usuario activas mientras la app está en segundo plano, igual que un emulador de terminal como Termux." />
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
